{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyStageBundle.components.stage.stage::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div ref="root"
         class="stage"
         :class="{ 'stage--readonly': readonly, 'stage--grid': grid > 0, 'stage--scrollable': scrollable, 'is-panning': !scrollable && gesture && gesture.type === 'pan' && gesture.moved }"
         :style="stageStyle"
         :tabindex="readonly ? null : 0"
         role="application"
         :aria-label="resolvedLabel"
         @pointerdown="onPointerDown"
         @dblclick="onDoubleClick"
         @wheel="onWheel">
        {#- Scrollable: what the scrollbars span. -#}
        <div v-if="scrollable" class="stage--extent" :style="extentStyle"></div>

        <div class="stage--world" :style="worldStyle">
            {#- What the page lays on the surface besides its items — links,
                regions, ribbons —, each layer told where the items stand
                (stage-links, stage-regions): under the items by default, a
                layer raising what must stand over them. -#}
            <slot name="layers"></slot>

            <div v-for="item in placed"
                 :key="item.id"
                 class="stage--element"
                 :class="[item.kind ? 'stage--element--' + item.kind : null, lightClass(item.id), { 'is-selected': isSelected(item), 'is-unplaced': !isPlaced(item), 'is-laid': layout && settled[item.id] }]"
                 :style="elementStyle(item)"
                 :data-stage-element="item.id">
                <slot name="element" :element="item" :selected="isSelected(item)">
                    <div class="block block--card block--padded stage--element-default">[[ item.title || item.id ]]</div>
                </slot>
            </div>

        </div>

        <div v-if="marquee" class="stage--marquee" :style="marqueeStyle"></div>
        <slot name="overlay"></slot>
    </div>
{%- endblock -%}
