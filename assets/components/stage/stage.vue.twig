{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyStageBundle.components.stage.stage::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div ref="root"
         class="stage"
         :class="{ 'stage--readonly': readonly, 'stage--grid': grid > 0, 'is-panning': gesture && gesture.type === 'pan' && gesture.moved }"
         :style="stageStyle"
         :tabindex="readonly ? null : 0"
         role="application"
         :aria-label="resolvedLabel"
         @pointerdown="onPointerDown"
         @wheel="onWheel">
        <div class="stage--world" :style="worldStyle">
            {#- Under everything: the regions — lanes, days —, a title in their
                head. -#}
            <div v-for="region in regions"
                 :key="region.id"
                 class="stage--region"
                 :class="region.kind ? 'stage--region--' + region.kind : null"
                 :style="regionStyle(region)">
                <span v-if="region.title" class="stage--region-title">[[ region.title ]]</span>
            </div>

            {#- The links under the elements, in the same coordinates: an SVG of
                no size of its own, drawing past its box. -#}
            <svg class="stage--links" aria-hidden="true">
                <defs>
                    <marker :id="markerId" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="stage--arrow"></path>
                    </marker>
                </defs>
                <path v-for="link in drawnLinks"
                      :key="link.id"
                      class="stage--link"
                      :class="[link.kind ? 'stage--link--' + link.kind : null, lightClass(link.id), { 'is-selected': isLinkSelected(link) }]"
                      :d="linkPath(link)"
                      :marker-end="'url(#' + markerId + ')'"></path>
            </svg>

            {#- A link's word, where its line has room for it. -#}
            <span v-for="link in drawnLinks.filter((link) => link.label)"
                  :key="link.id + '-label'"
                  class="stage--link-label"
                  :class="lightClass(link.id)"
                  :style="{ left: linkLabelPoint(link).x + 'px', top: linkLabelPoint(link).y + 'px' }">[[ link.label ]]</span>

            <div v-for="item in items"
                 :key="item.id"
                 class="stage--element"
                 :class="[item.kind ? 'stage--element--' + item.kind : null, lightClass(item.id), { 'is-selected': isSelected(item) }]"
                 :style="elementStyle(item)"
                 :data-stage-element="item.id">
                <slot name="element" :element="item" :selected="isSelected(item)">
                    <div class="block block--card block--padded stage--element-default">[[ item.title || item.id ]]</div>
                </slot>
            </div>
        </div>

        <div v-if="marquee" class="stage--marquee" :style="marqueeStyle"></div>
        <slot name="overlay"></slot>
    </div>
{%- endblock -%}
